# Discord webhook URL (free) — create in your Discord server: Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Storage root (defaults to project root)
STORAGE_ROOT=.

# Retention (days)
ALERT_RETENTION_DAYS=7
FALSE_ALARM_RETENTION_DAYS=3

# Disk cap for clips (GB)
DISK_CAP_GB=3

# Detection
MODEL_NAME=yolov8n.pt
CONF_THRESHOLD=0.6
MIN_CONSECUTIVE_FRAMES=3
FRAME_SAMPLE_EVERY=4